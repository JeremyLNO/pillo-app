          "stringUnit": {
            "state": "translated",
            "value": "Haz una foto de tu blíster: Pillo Tracker intenta detectar automáticamente el número de comprimidos. Siempre podrás corregirlo después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
