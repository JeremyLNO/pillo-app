    "settings.trustedContact.enabled": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemanden benachrichtigen, wenn eine Einnahme unbestätigt bleibt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert someone if a dose stays unconfirmed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar a alguien si una toma queda sin confirmar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerter un proche en cas d'oubli prolongé"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar alguém se uma toma ficar por confirmar"
          }
        }
      }
    },
    "settings.trustedContact.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du deine Einnahme nach dieser Verzögerung nicht bestätigt hast, schlägt Pillo Tracker vor, diesem Kontakt eine Nachricht zu senden. Es wird nie automatisch etwas gesendet — du hast immer die Kontrolle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you haven't confirmed your dose after this delay, Pillo Tracker will offer to message this contact. Nothing is ever sent automatically — you're always in control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no has confirmado tu toma después de este plazo, Pillo Tracker te propondrá enviar un mensaje a este contacto. Nada se envía automáticamente: siempre tienes el control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu n'as pas confirmé ta prise après ce délai, Pillo Tracker te proposera d'envoyer un message à ce contact. Rien n'est envoyé automatiquement : tu gardes toujours le contrôle."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se não confirmares a tua toma após este atraso, o Pillo Tracker vai propor enviar uma mensagem a este contacto. Nada é enviado automaticamente: mantés sempre o controlo."
          }
        }
      }
    },
